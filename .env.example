# Example only; do not put production credentials here
# Prefer 127.0.0.1 over localhost on Windows (avoids IPv6 ::1 hang).
DATABASE_URL=postgresql://spotmap:spotmap_dev_only@127.0.0.1:5432/spotmap
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=18080
# Required for POST /v1/moderation/.../promote-geo. Leave empty to disable writes.
MODERATION_TOKEN=change_me_local_only
# Yandex Maps JS API key: https://developer.tech.yandex.ru/
# Restrict by HTTP referrer (e.g. http://127.0.0.1:18080/*)
YANDEX_MAPS_API_KEY=


