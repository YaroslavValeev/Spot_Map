# Example only; do not put production credentials here
# Prefer 127.0.0.1 over localhost on Windows (avoids IPv6 ::1 hang).
DATABASE_URL=postgresql://spotmap:spotmap_dev_only@127.0.0.1:5432/spotmap
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=18080
# Required for POST /v1/moderation/.../promote-geo. Leave empty to disable writes.
MODERATION_TOKEN=change_me_local_only
# Yandex Maps JS API key: https://developer.tech.yandex.ru/
# Restrict by HTTP referrer (e.g. http://127.0.0.1:18080/*)
YANDEX_MAPS_API_KEY=
# Comma-separated hosts allowed to iframe /embed (no scheme).
EMBED_ALLOWED_HOSTS=localhost,127.0.0.1,mywavewake.ru,www.mywavewake.ru
# Weather: MET Norway preferred (free CC BY 4.0) + Open-Meteo fallback.
WEATHER_PROVIDER=met_norway
WEATHER_MET_NORWAY_ENABLED=true
WEATHER_MET_NORWAY_BASE_URL=https://api.met.no
WEATHER_MET_NORWAY_CONTACT=https://mywavewake.ru y.valeev@gmail.com https://t.me/MyWave23
WEATHER_OPEN_METEO_ENABLED=true
WEATHER_OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Free wind overlay: arrows_grid | disabled (do not buy Yandex Weather tiles).
WEATHER_WIND_LAYER_MODE=arrows_grid
YANDEX_WEATHER_TILE_KEY=
# Salt for hashing client IP on /go booking clicks (not stored raw).
BOOKING_CLICK_IP_SALT=change_me_local_only

